<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OmniPlayer</AssemblyName>
    <RootNamespace>OmniPlayer</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>OmniPlayer</Product>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- libVLC engine: decodes HEVC/H.265, AV1, VP9, H.264, MPEG-2/4, DivX, WMV, ProRes, MKV, AVI, FLAC, DTS, AC-3, ... -->
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" />
  </ItemGroup>

</Project>
